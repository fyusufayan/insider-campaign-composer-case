# Rendered at container start by the nginx image entrypoint (envsubst):
#   ${API_UPSTREAM}          Go API host:port on the Compose network (default api:8080)
#   ${NGINX_LOCAL_RESOLVERS} resolvers from /etc/resolv.conf (Docker's embedded DNS)
# Every other $variable below is an nginx variable and is left untouched.

# Re-resolve the API name at request time: nginx starts even if the api
# container is not resolvable yet and follows it when it is recreated.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;
resolver_timeout 2s;

map $http_x_request_id $composer_request_id {
    default $http_x_request_id;
    ""      $request_id;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;

    # The API limits JSON bodies to 64 KiB; allow a little more so the API, not
    # nginx, produces the validation error.
    client_max_body_size 256k;

    # Response headers are set per location: nginx does not inherit add_header
    # into a location that declares its own.

    set $api_upstream http://${API_UPSTREAM};

    # ---- API (same origin: no CORS needed) ---------------------------------
    # proxy_pass with a variable and no URI forwards the original request URI
    # unchanged; method, body and upstream status codes pass through as-is.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $composer_request_id;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE-safe: the content generation stream (POST .../content/generations)
        # and, in Slice 5, the status stream. The API also sends
        # X-Accel-Buffering: no and a keep-alive comment every 15 s.
        proxy_buffering off;
        proxy_cache off;
        proxy_request_buffering on;
        proxy_connect_timeout 5s;
        proxy_send_timeout 60s;
        # Interpretation may take up to CLAUDE_SEGMENT_TIMEOUT (45 s by default)
        # plus the repair turn; streams send data continuously.
        proxy_read_timeout 300s;

        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;

        # nginx-generated errors only (API responses, including its own 5xx
        # error envelopes, are not intercepted).
        error_page 502 503 504 = @api_unavailable;
    }

    # Readiness, incl. llm_provider for the demo-mode badge. Exact match: no
    # other API path outside /api/ is exposed (no /metrics, no /healthz).
    location = /readyz {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Request-ID $composer_request_id;
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
        add_header Cache-Control "no-store" always;
        error_page 502 503 504 = @api_unavailable;
    }

    location @api_unavailable {
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 502 "API unavailable\n";
    }

    # ---- SPA -----------------------------------------------------------------
    # Hashed build assets: cache forever; a missing asset is a real 404.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # Client-side routes (/campaigns/new, /campaigns/{id}) fall back to
    # index.html so a reload or a shared link opens the app.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    }
}
