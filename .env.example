# Copy to .env for local overrides. Never commit .env.
#
# Docker Compose reads .env from the repository root for variable substitution.
# It builds the containers' DATABASE_URL itself from the POSTGRES_* values below
# (the DATABASE_URL line is for running the Go binaries on the host).

# Compose: host port of the web UI (bound to 127.0.0.1 only), and the local-only
# database credentials (the database is not published to the host).
COMPOSER_HTTP_PORT=8000
POSTGRES_USER=composer
POSTGRES_PASSWORD=composer
POSTGRES_DB=composer

# PostgreSQL connection string (required).
DATABASE_URL=postgres://composer:composer@localhost:5432/composer?sslmode=disable

# API listen address.
HTTP_ADDR=:8080

# LLM provider, resolved once at startup: auto | anthropic | demo.
# auto selects anthropic when ANTHROPIC_API_KEY is non-empty, otherwise demo.
# anthropic without a key fails at startup; anthropic failures never fall back
# to demo. WARNING: with a key, every interpretation is a billable API request.
# Set the key only in your uncommitted .env or shell; never commit it.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# Automatic SDK retries per model request (connection errors, 408, 409, 429,
# 5xx), 0–5. All attempts share CLAUDE_SEGMENT_TIMEOUT.
CLAUDE_MAX_RETRIES=2

# Brief interpretation model (model names come only from configuration).
# Default claude-haiku-5-5 (ADR-015); claude-sonnet-5-5 or claude-opus-5-5 can be set explicitly.
CLAUDE_SEGMENT_MODEL=claude-haiku-5-5
CLAUDE_SEGMENT_EFFORT=low
CLAUDE_SEGMENT_TIMEOUT=45s
CLAUDE_SEGMENT_MAX_TOKENS=4000

# Content generation model (ADR-015: not yet evaluated, default claude-opus-5-5).
# No HTTP route reaches content generation yet (streaming endpoint is Slice 2's
# next checkpoint), so these settings cause no API spend today.
CLAUDE_CONTENT_MODEL=claude-opus-5-5
CLAUDE_CONTENT_EFFORT=medium
CLAUDE_CONTENT_TIMEOUT=90s
CLAUDE_CONTENT_MAX_TOKENS=8000

# Approval workflow (ADR-006, ARCHITECTURE §5.3). A prepared approval must be
# confirmed within APPROVAL_PENDING_TTL (1s–24h); a confirmed approval may be
# used for sending until APPROVAL_APPROVED_TTL after confirmation (1s–168h).
# Shorten both (e.g. 30s / 1m) to demonstrate expiry. APPROVER_NAME is recorded
# as approved_by (there is no authentication).
APPROVAL_PENDING_TTL=15m
APPROVAL_APPROVED_TTL=24h
APPROVER_NAME=marketer@demo

# Deterministic seed (cmd/seed). The same three values always produce the same
# dataset; SEED_REFERENCE_TIME must be RFC 3339 in UTC. `make seed-today` uses
# today's UTC midnight instead of the fixed default.
SEED_USERS=5000
SEED_RANDOM_SEED=42
SEED_REFERENCE_TIME=2026-11-01T00:00:00Z

# Delivery (CP16/CP17). The worker sends only rows released by an explicit
# POST /send, through the mock provider (no real SMS/email vendor exists).
# Exactly one worker replica (the rate limiter is in-process; a second process
# would only stand by). Rate: at most RATE_LIMIT_PER_SECOND requests per
# channel in any (1 s + RATE_SAFETY_MARGIN) window, retries included; startup
# requires DISPATCH_MAX_PRECHECK < DISPATCH_MAX_SLOT_TO_REQUEST < RATE_SAFETY_MARGIN.
# Transient retries: full-jitter backoff in [0, min(BACKOFF_CAP,
# BACKOFF_BASE·2^(n-1))); 429: Retry-After (1 s .. RETRY_AFTER_CAP) pauses
# that channel only. DELIVERY_RETRY_DELAY (CP16) was removed: setting it is
# a startup error.
PROVIDER_REQUEST_TIMEOUT=5s
SENDER_POOL_SIZE=20
CLAIM_BATCH_SIZE=50
LEASE_DURATION=60s
WORKER_POLL_INTERVAL=500ms
MAX_TRANSIENT_ATTEMPTS=5
MAX_RATE_LIMITED_ATTEMPTS=10
BACKOFF_BASE=1s
BACKOFF_CAP=60s
RETRY_AFTER_CAP=30s
RATE_LIMIT_PER_SECOND=100
RATE_SAFETY_MARGIN=50ms
DISPATCH_MAX_SLOT_TO_REQUEST=20ms
DISPATCH_MAX_PRECHECK=15ms
# Background approval-expiry sweep period (expiry is also enforced lazily).
APPROVAL_SWEEP_INTERVAL=30s

# Mock provider fault injection (set the rates to 0 and the pattern to "-"
# for a clean run). Destinations ending with the pattern are rejected.
MOCK_FAULT_5XX_RATE=0.03
MOCK_FAULT_429_RATE=0.01
MOCK_FAULT_TIMEOUT_RATE=0.005
MOCK_LATENCY_MS=50-200
MOCK_PERMANENT_FAIL_PATTERN=0000
MOCK_RANDOM_SEED=1
# The mock's own strict per-channel limit (0 disables).
MOCK_RATE_LIMIT_PER_SECOND=100
