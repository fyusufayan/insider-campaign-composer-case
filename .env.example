# Copy to .env for local overrides. Never commit .env.
#
# Docker Compose reads .env from the repository root for variable substitution.
# It builds the containers' DATABASE_URL itself from the POSTGRES_* values below
# (the DATABASE_URL line is for running the Go binaries on the host).

# Compose: host port of the web UI (bound to 127.0.0.1 only), and the local-only
# database credentials (the database is not published to the host).
COMPOSER_HTTP_PORT=8000
POSTGRES_USER=composer
POSTGRES_PASSWORD=composer
POSTGRES_DB=composer

# PostgreSQL connection string (required).
DATABASE_URL=postgres://composer:composer@localhost:5432/composer?sslmode=disable

# API listen address.
HTTP_ADDR=:8080

# LLM provider, resolved once at startup: auto | anthropic | demo.
# auto selects anthropic when ANTHROPIC_API_KEY is non-empty, otherwise demo.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=

# Brief interpretation model (model names come only from configuration).
CLAUDE_SEGMENT_MODEL=claude-opus-5-5
CLAUDE_SEGMENT_EFFORT=low
CLAUDE_SEGMENT_TIMEOUT=45s
CLAUDE_SEGMENT_MAX_TOKENS=4000

# Deterministic seed (cmd/seed). The same three values always produce the same
# dataset; SEED_REFERENCE_TIME must be RFC 3339 in UTC. `make seed-today` uses
# today's UTC midnight instead of the fixed default.
SEED_USERS=5000
SEED_RANDOM_SEED=42
SEED_REFERENCE_TIME=2026-11-01T00:00:00Z
